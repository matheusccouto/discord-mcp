# Bot token from https://discord.com/developers/applications, Bot tab.
DISCORD_BOT_TOKEN=

# Comma separated path families to expose. Default: channels,users
DISCORD_FAMILIES=channels,users

# Optional GitHub login. Set all four, or none.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_LOGIN=
JWT_SIGNING_KEY=
PUBLIC_URL=
